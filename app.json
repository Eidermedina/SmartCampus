{
  "expo": {
    "name": "SMARTCAMPUS UDEC GIRARDOT",
    "slug": "miApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-v2.png",
    "scheme": "miapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.miapp.smartcampus",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-v2.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La aplicación necesita acceder a tus fotos para adjuntar evidencia visual en los reportes.",
          "cameraPermission": "La aplicación necesita acceder a tu cámara para tomar fotos de las incidencias.",
          "microphonePermission": "La aplicación necesita acceso al micrófono para grabar videos en la cámara."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}